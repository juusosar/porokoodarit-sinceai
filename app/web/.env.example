# Browser-facing API URL (FastAPI in app/api). Runtime override: public/env.js / container env.
VITE_API_URL=http://localhost:8080
# on = server voice (ElevenLabs via API) with browser fallback, browser = browser voice only, off = no voice.
VITE_VOICE=on
# Live fit card during the flow (on|off).
VITE_LIVE_FIT_CARD=on
