# Rendered by the nginx image at start (envsubst): ${PORT} comes from the container env.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

    # Hashed build output: cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Big static assets: real 404, never the app shell (MediaPipe would get HTML).
    location ~ ^/(mediapipe|models)/ {
        try_files $uri =404;
    }

    # Runtime config + app shell: always revalidate.
    location = /env.js {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    # SPA fallback (same as vercel.json rewrite).
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
