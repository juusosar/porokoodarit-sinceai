TAKOMO_ENV=local
TAKOMO_CORS_ORIGINS=http://localhost:5173
# Demo mode unlocks PUT /v1/settings (provider switch panel, open web app with ?demo=1). Never in prod.
TAKOMO_DEMO_MODE=true
# LLM (explain only). Without a key the API uses reason-code templates.
TAKOMO_LLM_PROVIDER=gemini
TAKOMO_LLM_MODEL_STEP=gemini-flash-latest
TAKOMO_LLM_MODEL_FINAL=gemini-pro-latest
# Per role: step lines (short, frequent) vs final walkthrough (once, longer).
# TIMEOUT_S = step_line timeout.
TAKOMO_LLM_TIMEOUT_S=6
TAKOMO_LLM_TIMEOUT_S_FINAL=12
# Gemini 3+ thinking effort: minimal|low|medium|high, empty = model default (slow). Gemini 2.x: leave empty.
TAKOMO_LLM_THINKING_LEVEL_STEP=minimal
TAKOMO_LLM_THINKING_LEVEL_FINAL=low
TAKOMO_GEMINI_API_KEY=
# Keyless option (Vertex AI + Application Default Credentials). Leave the key empty and set these.
# Locally: `gcloud auth application-default login`. Cloud Run: service account needs roles/aiplatform.user.
# On Vertex the *-latest aliases map to gemini-3.8-flash (Gemini 2.5 retired on Vertex 2026-10-20).
TAKOMO_GEMINI_VERTEX=false
TAKOMO_GCP_PROJECT=
TAKOMO_GCP_LOCATION=global
# Voice (TTS) for host lines. none = off (web uses the browser voice). elevenlabs = server voice, key server-only.
TAKOMO_TTS_PROVIDER=none
TAKOMO_ELEVENLABS_API_KEY=
# Stock premade voice id + Flash v2.5 (~100 ms, half a credit per character). English only.
TAKOMO_ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
TAKOMO_ELEVENLABS_MODEL=eleven_flash_v2_5
# Spend cap per instance per UTC day (characters sent to ElevenLabs; cache hits are free).
TAKOMO_TTS_DAILY_CHARS=20000
